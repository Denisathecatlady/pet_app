+def _energy_need_flags(usable_kcal: Decimal | None, energy: EnergyEstimate) -> list[Flag]:
+    """``RATION_ENERGY_OUTSIDE_NEED``: úplná ME dávky leží mimo rozsah odhadu potřeby.
+
+    Rozsah je ``[kcal_low, kcal_high]`` odhadu energie (z dat ``EnergyFactor``);
+    jádro žádnou další toleranci nepřidává.
+    """
+    low, high = energy.kcal_low, energy.kcal_high
+    if usable_kcal is None or low is None or high is None or low <= usable_kcal <= high:
+        return []
+    need = (
+        f"odhad {format_decimal_cs(low)} kcal/den"
+        if low == high
+        else f"rozsah {format_decimal_cs(low)}–{format_decimal_cs(high)} kcal/den"
+    )
+    return [
+        Flag(
+            WarningLevel.NUTRITION_WARNING,
+            "RATION_ENERGY_OUTSIDE_NEED",
+            f"ME dávky ({format_decimal_cs(usable_kcal)} kcal/den) je mimo odhad energetické "
+            f"potřeby zvířete ({need}). Vyhodnocení na 1000 kcal ME předpokládá, že zvíře "
+            "dávkou pokryje svou energetickou potřebu; při jiném příjmu energie neodpovídá ani "
+            "denní příjem živin. Upravte množství dávky a rozbor zopakujte.",
+        )
+    ]
+
+
+def _suppressed(energy: EnergyEstimate) -> EnergyEstimate:
+    """Odhad energie bez čísel při bráně ``BLOCKED`` (jako u BCS 1–2, docs/09 §9.2)."""
+    if energy.kcal_point is None:
+        return energy
+    return replace(
+        energy,
+        status=EnergyStatus.BLOCKED,
+        kcal_point=None,
+        kcal_low=None,
+        kcal_high=None,
+        rer_kcal=None,
+        flags=sorted_flags(
