index cfe2afc..77f4dff 100644
--- a/nutricalc/decimal_ctx.py
+++ b/nutricalc/decimal_ctx.py
@@ -169,3 +169,49 @@ def to_optional_decimal(
     if value is None:
         return None
     return to_decimal(value, signed=signed, name=name)
+
+
+def positive_decimal(value: Decimal | int | str, name: str) -> Decimal:
+    """Převede vstup na kladné ``Decimal`` (sdílená kontrola modulů jádra).
+
+    Vstup: hodnota pro :func:`to_decimal` (bez znaménka) a český název údaje
+    pro zprávu.
+    Výstup: ``Decimal`` > 0.
+    Chyby: jako :func:`to_decimal`;
+    :class:`~nutricalc.errors.InvalidInputError` (podtřída
+    :class:`~nutricalc.errors.ValidationError`) pro hodnotu ≤ 0.
+    """
+    number = to_decimal(value, name=name)
+    if not number > 0:
+        raise InvalidInputError(f"{name} musí být větší než 0 (zadáno {number}).")
+    return number
+
+
+def decimal_text(value: Decimal) -> str:
+    """Text čísla ``Decimal`` nezávislý na kontextu volajícího.
+
+    ``str(Decimal)`` bere tvar exponentu (``E`` nebo ``e``) z aktuálního
+    kontextu (``Context.capitals``); tato funkce převádí v kontextu jádra,
+    takže text je vždy stejný (např. ``"0E+2"``). Tvar čísla (exponent,
+    koncové nuly) zůstává přesně jako v hodnotě.
+
+    Vstup: ``Decimal``. Výstup: text. Chyby: ``TypeError`` pro jiný typ.
+    """
+    if not isinstance(value, Decimal):
+        raise TypeError(f"decimal_text očekává Decimal, ne {type(value).__name__}.")
+    with calc_context():
+        return str(value)
+
+
+def plain_text(value: Decimal) -> str:
+    """Text čísla pro zprávy: desetinný zápis bez exponentu (``"1E+3"`` → ``"1000"``).
+
+    Formát ``f`` nezávisí na kontextu volajícího. Slouží jen pro texty
+    upozornění a chyb; pro zobrazení v UI je
+    :func:`nutricalc.evaluation.format_decimal_cs`.
+
+    Vstup: ``Decimal``. Výstup: text. Chyby: ``TypeError`` pro jiný typ.
+    """
+    if not isinstance(value, Decimal):
+        raise TypeError(f"plain_text očekává Decimal, ne {type(value).__name__}.")
+    return format(value, "f")
