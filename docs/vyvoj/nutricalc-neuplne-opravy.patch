+def unhandled_safety_flags(
+    rules: Iterable[WarningRule], context: RuleContext
+) -> tuple[Flag, ...]:
+    """Bezpečnostní příznaky surovin, na které neodkazuje žádné pravidlo pro druh zvířete.
+
+    Pojistka proti neúplným datům pravidel: každý příznak ze
+    ``IngredientProfile.safety_flags`` některé suroviny dávky musí být
+    podmínkou :class:`IngredientFlagPresent` aspoň jednoho pravidla, které
+    platí pro druh zvířete (``species`` je ``None`` nebo druh obsahuje).
+    Jinak vznikne upozornění ``UNHANDLED_SAFETY_FLAG`` úrovně
+    ``EXPERT_REQUIRED`` (předmět = příznak, ve zprávě suroviny), které
+    vstupuje do bezpečnostní brány. Jádro význam příznaku nezná, proto
+    neblokuje; rozhodne odborník, případně doplní pravidlo do dat.
+
+    Vstup: pravidla (libovolné pořadí) a :class:`RuleContext`.
+    Výstup: upozornění seřazená podle :func:`~nutricalc.flags.sorted_flags`.
+    Chyby: ``TypeError`` pro jiné typy.
+    """
+    if not isinstance(context, RuleContext):
+        raise TypeError(f"unhandled_safety_flags očekává RuleContext, ne {type(context).__name__}.")
+    handled: set[str] = set()
+    for rule in rules:
+        if not isinstance(rule, WarningRule):
+            raise TypeError(f"Pravidlo musí být WarningRule, ne {type(rule).__name__}.")
+        if isinstance(rule.condition, IngredientFlagPresent) and rule.applies_to(context.species):
+            handled.add(rule.condition.flag)
+    present: dict[str, list[str]] = {}
+    for entry in context.items:
+        for flag in entry.profile.safety_flags:
+            present.setdefault(flag, []).append(entry.ingredient_code)
+    species = SPECIES_LABELS[context.species]
+    return sorted_flags(
+        Flag(
+            WarningLevel.EXPERT_REQUIRED,
+            "UNHANDLED_SAFETY_FLAG",
+            f"Bezpečnostní příznak „{flag}“ (suroviny: {', '.join(sorted(codes))}) nemá v datech "
+            f"pravidel žádné pravidlo pro druh {species}. Jádro význam příznaku nezná; dávku "
+            "musí posoudit odborník.",
+            subject=flag,
+        )
+        for flag, codes in present.items()
+        if flag not in handled
+    )
