+def _upper_limited(kinds_by_code: Mapping[str, Iterable[RequirementType]]) -> set[str]:
+    """Kódy živin, které profil omezuje shora (vlastní maximum nebo poměr).
+
+    Vlastní maximum: ``NUTRITIONAL_MAX``, ``SUL``, ``LEGAL_MAX_EU``. Poměr
+    čitatel/jmenovatel (:data:`RATIO_COMPONENTS`): ``RATIO_MAX`` omezuje shora
+    čitatele (Ca), ``RATIO_MIN`` jmenovatele (P).
+    """
+    kinds = {
+        code: {as_member(RequirementType, kind, "typ požadavku") for kind in values}
+        for code, values in kinds_by_code.items()
+    }
+    limited = {code for code, values in kinds.items() if values & MAXIMUM_TYPES}
+    for ratio, (numerator, denominator) in RATIO_COMPONENTS.items():
+        values = kinds.get(ratio, set())
+        if RequirementType.RATIO_MAX in values:
+            limited.add(numerator)
+        if RequirementType.RATIO_MIN in values:
+            limited.add(denominator)
+    return limited
+
+
+def _findings_sentence(counts: Mapping[NutrientStatus, int]) -> str:
+    parts = [f"{label} {counts[status]}" for status, label in _FINDING_LABELS if counts[status]]
+    if not parts:
+        return ""
+    return f" Mezi vyhodnocenými živinami a poměry zjištěno: {', '.join(parts)}."
+
 
