# Example crontab of the BARF Nutri server (docs/13-nasazeni-a-provoz.md).
# Install it for the account that runs the application (crontab -e) and adjust the paths.
# Nothing secret belongs in this file: the scripts read their configuration from the files
# below (mode 600), and cron mails the output of a job only when the job fails.
#
#   /etc/barf/ops.env      POSTGRES_* of a read-only backup role, BACKUP_DIR,
#                          BACKUP_PASSPHRASE_FILE (read by backup_db.sh through BARF_ENV_FILE)
#   /etc/barf/restore.env  the same, but POSTGRES_USER is a role with CREATEDB, and
#                          RESTORE_TEST_LOG (read by restore_test.sh)
#   /etc/barf/app.env      the variables of .env.example (read by the daily Django jobs below)
#
# The daily Django jobs load app.env with the shell, so values that contain spaces or < > must be
# quoted there: DJANGO_DEFAULT_FROM_EMAIL='BARF Nutri <noreply@barf.example.cz>'. A systemd
# EnvironmentFile accepts the same quoted form.
#
# The hours below are in the time zone set by CRON_TZ (cron implementations without CRON_TZ use
# the server time zone). Backup file names and the protocol of the restore test are always UTC.

SHELL=/bin/bash
CRON_TZ=Europe/Prague
MAILTO=admin@barf.example.cz
BARF_ENV_FILE=/etc/barf/ops.env
DJANGO_SETTINGS_MODULE=config.settings.prod

# minute hour day-of-month month day-of-week  command

# Daily encrypted backup, then retention: the newest 30 backups and the first backup of each of
# the last 12 months are kept. Failure (non-zero exit) is mailed to MAILTO.
17 2 * * * /opt/barf/deploy/backup_db.sh >>/var/log/barf/backup.log 2>&1 || echo "BARF backup FAILED, see /var/log/barf/backup.log"

# Monthly restore test of the newest backup into a scratch database (docs/07 §7.7). Runs on the
# 3rd of the month, after the backup of that night; appends one line to RESTORE_TEST_LOG.
# The database role needs CREATEDB. FAIL (non-zero exit) is mailed to MAILTO.
41 4 3 * * BARF_ENV_FILE=/etc/barf/restore.env /opt/barf/deploy/restore_test.sh >>/var/log/barf/restore-test.log 2>&1 || echo "BARF restore test FAILED, see /var/log/barf/restore-test.log"

# Daily: delete registrations nobody activated within 7 days (PENDING_ACCOUNT_RETENTION).
23 3 * * * bash -c 'set -a; . /etc/barf/app.env; set +a; cd /opt/barf/backend && exec /opt/barf/.venv/bin/python manage.py purge_pending_accounts' >>/var/log/barf/jobs.log 2>&1 || echo "BARF purge_pending_accounts FAILED, see /var/log/barf/jobs.log"

# Daily: delete expired sessions from the database.
29 3 * * * bash -c 'set -a; . /etc/barf/app.env; set +a; cd /opt/barf/backend && exec /opt/barf/.venv/bin/python manage.py clearsessions' >>/var/log/barf/jobs.log 2>&1 || echo "BARF clearsessions FAILED, see /var/log/barf/jobs.log"
