# Example environment for config.settings.prod (no real values). The application does not
# read this file itself: pass the variables via the process manager, container or shell.
# Comments stay on their own lines: some loaders treat text after "=" literally.

# --- Required ---
# At least 50 random characters, e.g. from django.core.management.utils.get_random_secret_key()
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=barf.example.cz
POSTGRES_DB=barf
POSTGRES_USER=barf
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Optional ---
DJANGO_CSRF_TRUSTED_ORIGINS=https://barf.example.cz
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Enable preload only after a deliberate decision: removal from browser lists takes months.
DJANGO_SECURE_HSTS_PRELOAD=false
# Behind a TLS-terminating proxy that overwrites the header, e.g. HTTP_X_FORWARDED_PROTO,https
DJANGO_SECURE_PROXY_SSL_HEADER=
# Number of trusted reverse proxies appending to X-Forwarded-For (login lockout by client IP).
DJANGO_TRUSTED_PROXY_COUNT=0
DJANGO_STATIC_ROOT=
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_DEFAULT_FROM_EMAIL=BARF Nutri <noreply@barf.example.cz>
DJANGO_LOG_LEVEL=INFO
